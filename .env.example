# Recommended agent runtime. Use real values only in the ignored `.env` file.
AGENT_MODEL_PROVIDER=openrouter
AGENT_MODEL_INTENSITY=max
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_MAX_TOKENS=12000
OPENROUTER_SITE_URL=http://localhost:3000
OPENROUTER_APP_NAME=Magic Agent

# Optional OpenAI runtime and YouTube visual/subagent quality stages.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4
OPENAI_REASONING_EFFORT=low
OPENAI_VERBOSITY=low

MAGIC_HOUR_API_KEY=

# Recommended narration provider.
ELEVENLABS_API_KEY=
ELEVENLABS_AUDIO_MODEL=eleven_multilingual_v2
ELEVENLABS_VOICE_ID=
ELEVENLABS_VOICE_NAME=brielle - podcast girl

# Optional narration providers.
FISH_AUDIO_API_KEY=
FISH_AUDIO_REFERENCE_ID=
HUME_API_KEY=

# YouTube source-clip workflow. One key is enough; numbered aliases rotate.
YOUTUBE_API_KEY=
YOUTUBE_API_KEY_1=
YOUTUBE_API_KEY_2=
YOUTUBE_API_KEY_3=
YOUTUBE_SUBAGENTS_ENABLED=true
YOUTUBE_VISUAL_VERIFY=true

OUTPUT_DIR=outputs

# Project-level generation concurrency. Use "auto" for local hardware parallelism,
# or set an explicit number for the deployment instance.
PROJECT_RUN_CONCURRENCY=auto

# Provider-level throttles keep parallel projects from stampeding external APIs.
HUME_TTS_CONCURRENCY=1
FISH_TTS_CONCURRENCY=2
MAGIC_HOUR_SUBMIT_CONCURRENCY=5
MAGIC_HOUR_SUBMIT_TIMEOUT_MS=60000

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_HOST=127.0.0.1
FRONTEND_PORT=3000
API_PUBLIC_HOST=localhost
FRONTEND_PUBLIC_HOST=localhost

MAGIC_HOUR_IMAGE_MODEL=nano-banana-2-lite
MAGIC_HOUR_IMAGE_RESOLUTION=1k
MAGIC_HOUR_IMAGE_STYLE_TOOL=general
MAGIC_HOUR_VIDEO_MODEL=minimax-h3
OPENAI_AGENT_MAX_TURNS=30
MAGIC_HOUR_VIDEO_AUDIO=false
AUDIO_PROVIDER=elevenlabs
FISH_AUDIO_MODEL=s2.1-pro
FISH_AUDIO_FORMAT=mp3
HUME_AUDIO_MODEL=octave-1
HUME_VOICE_ID=
HUME_VOICE_NAME=
HUME_VOICE_PROVIDER=HUME_AI
HUME_VOICE_DESCRIPTION=
ELEVENLABS_TTS_CONCURRENCY=2
